# Application
ENVIRONMENT=development
APP_NAME=GraveyAI API
API_V1_PREFIX=/api/v1

# Authentication
# The mock provider is development-only and fails closed outside development.
IDENTITY_PROVIDER=mock
DEVELOPMENT_IDENTITY_TOKEN=development-token

# AI
AI_PROVIDER=mock
AI_MODEL=gpt-5.6-luna
OPENAI_API_KEY=

# Voice
VOICE_STT_PROVIDER=mock
VOICE_TTS_PROVIDER=mock
VOICE_MAX_AUDIO_BYTES=10000000

# Database (local development)
POSTGRES_DB=graveyai
POSTGRES_USER=graveyai
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://graveyai:change-me@localhost:5432/graveyai
